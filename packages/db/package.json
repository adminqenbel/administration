{
  "name": "@qenbel/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "node scripts/db.ts migrate",
    "migrate:test": "node scripts/db.ts migrate --test",
    "seed": "node scripts/db.ts seed",
    "seed:reset": "node scripts/db.ts seed --reset",
    "db:check": "node scripts/db.ts check",
    "infra:up": "docker compose -f ../../infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f ../../infra/docker-compose.yml down",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "check": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
