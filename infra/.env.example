# Names only. Copy to infra/.env (git-ignored) and set values. Never commit real values.
POSTGRES_PASSWORD=
# Optional: separate passwords for the runtime roles (default to POSTGRES_PASSWORD).
QENBEL_APP_PASSWORD=
QENBEL_MIGRATE_PASSWORD=
QENBEL_PLATFORM_PASSWORD=
# Least-privilege login roles (infra/postgres/apply-roles.sh). Set distinct values outside local development.
QENBEL_AUTH_PASSWORD=
QENBEL_PLATFORM_OPS_PASSWORD=
# 1 = refuse to fall back to POSTGRES_PASSWORD for the two roles above
QENBEL_REQUIRE_DISTINCT_PASSWORDS=
# Optional explicit URLs (otherwise derived): DATABASE_AUTH_URL, DATABASE_PLATFORM_URL; tests: TEST_DATABASE_AUTH_URL, TEST_DATABASE_PLATFORM_URL
DATABASE_AUTH_URL=
DATABASE_PLATFORM_URL=
# Signed tenant context (SEC-003, migration 021): hex, at least 32 bytes; the same value must be installed with db.ts tenant-proof enable
QENBEL_TENANT_PROOF_KEY=
QENBEL_TENANT_PROOF_KEY_PREVIOUS=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
