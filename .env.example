# Names only. Real values go in the untracked .env or the host's environment. Never commit secrets.

NODE_ENV=development
# central = shared multi-tenant cloud; isolated = one dedicated tenant per deployment
DEPLOYMENT_MODE=central
PORT=4000
PUBLIC_API_ORIGIN=http://localhost:4000
PUBLIC_WEB_ORIGIN=http://localhost:5173

# Postgres (infra/docker-compose.yml). APP role is subject to RLS; MIGRATE role owns the schema.
POSTGRES_PASSWORD=
DATABASE_URL=
DATABASE_MIGRATE_URL=
REDIS_URL=redis://localhost:6379

# Object storage (S3 compatible)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Auth. AUTH_PROVIDER=dev is allowed only when NODE_ENV=development and bound to localhost.
AUTH_PROVIDER=dev
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
TOKEN_SIGNING_SECRET=

# Outbound webhooks and API credentials
WEBHOOK_SIGNING_MASTER_KEY=
API_KEY_PEPPER=

# AI runtime (website chat, WhatsApp). Voice providers call the tool gateway instead.
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=
AI_TENANT_DAILY_TOKEN_CAP=

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Email notifications (SMTP2GO API, same provider as qenbel.site)
SMTP2GO_API_KEY=
